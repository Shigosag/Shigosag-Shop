generator client {
  provider = "prisma-client-js"
  binaryTargets = [
    "native",
    "debian-openssl-3.0.x",
    "debian-openssl-1.1.x"
  ]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  role     String @default("user")
}

model Product {
  id          String @id @default(uuid())
  name        String
  description String
  price       Float
  image       String
}

model Order {
  id        String @id @default(uuid())
  total     Float
  createdAt DateTime @default(now())
}
